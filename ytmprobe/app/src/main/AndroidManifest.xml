<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: without this we cannot see YTM at all. -->
    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
    </queries>

    <!-- Car App Library: required for Android Auto to surface this app. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:label="YTM Probe"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material">

        <!-- "YTM Old" — kept startable via adb/explicit Intent for testing
             even without a LAUNCHER filter (exported has no bearing on
             same-app navigation; this only affects external callers). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="YTM Old" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="Diagnostics" />

        <!-- "YTM Launch" — the app's actual startup screen. -->
        <activity
            android:name=".QuickPlayActivity"
            android:exported="true"
            android:label="YTM Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required to obtain MediaSessionManager.getActiveSessions().
             The service itself does nothing; its existence is what grants
             the app eligibility for Notification Access. -->
        <service
            android:name=".NotifListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Android Auto surface: 5 random favorites + refresh.
             Category IOT because Android Auto has no "utility" category and
             this is not navigation, messaging, or calling. Sideload only. -->
        <service
            android:name=".ResumeCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Foreground service so session appear/disappear events keep being
             logged overnight and during the drive. -->
        <service
            android:name=".SessionLogger"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>
</manifest>
