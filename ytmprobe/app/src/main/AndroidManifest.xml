<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: without this we cannot see YTM at all. -->
    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
    </queries>

    <!-- Car App Library: required for Android Auto to surface this app. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="true" />

    <!-- enableOnBackInvokedCallback="false": Android 16 (targetSdk 36, bumped
         for ResumeCarAppService's intentMatchingFlags below) reserves the
         screen edges more aggressively for the predictive back gesture,
         which broke left/right swipe on favorite rows (FavoriteGestures,
         LaunchActivity's ItemTouchHelper) — both rows span full width, so
         a swipe starting near an edge was being intercepted by the system
         gesture before our own touch handling ever saw it. No per-region
         opt-out exists; this app has no back-stack navigation predictive
         back's animation would meaningfully improve anyway, so opting out
         app-wide is the documented, supported fix. -->
    <application
        android:allowBackup="false"
        android:label="YTM Launcher"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material"
        android:enableOnBackInvokedCallback="false">

        <!-- "YTM Old" — kept startable via adb/explicit Intent for testing
             even without a LAUNCHER filter (exported has no bearing on
             same-app navigation; this only affects external callers). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="YTM Old" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="Diagnostics" />

        <!-- "YTM Launch (v1)" — retired in favor of LaunchActivity below;
             kept startable via the 3-dot menu/adb for comparison, same as
             "YTM Old". -->
        <activity
            android:name=".QuickPlayActivity"
            android:exported="true"
            android:label="YTM Launch (v1)" />

        <!-- "YTM Launch" — the app's actual startup screen. RecyclerView/
             ItemTouchHelper rebuild of QuickPlayActivity's swipe gestures,
             confirmed working on-device and promoted to the default entry
             point. -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:label="YTM Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required to obtain MediaSessionManager.getActiveSessions().
             The service itself does nothing; its existence is what grants
             the app eligibility for Notification Access. -->
        <service
            android:name=".NotifListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Fired only by our own notification taps (PendingIntent carries
             our identity regardless of exported). A real Activity rather
             than a BroadcastReceiver — see PlayFavoriteActivity's doc
             comment for why a broadcast-mediated activity launch gets
             silently blocked as a "notification trampoline" on targetSdk
             31+. NoDisplay: nothing is ever drawn; noHistory/
             excludeFromRecents: it must not linger anywhere once finish()
             runs. -->
        <activity
            android:name=".PlayFavoriteActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay"
            android:noHistory="true"
            android:excludeFromRecents="true" />

        <!-- Android Auto surface: 5 random favorites + refresh.
             Category IOT because Android Auto has no "utility" category and
             this is not navigation, messaging, or calling. Sideload only.

             intentMatchingFlags="allowNullAction": Android 15+ enforces exact
             intent-filter matching by default, and the intent Android Auto's
             own app sends to bind/discover a CarAppService doesn't satisfy
             that exact match (confirmed via Home Assistant's Android Auto
             GitHub issue #5534 — identical PackageManager "Intent does not
             match component's intent filter" / "Access blocked" log lines).
             Without this, the service is invisible to AA's app list, not
             just unbindable — it never even reaches Customize Launcher. -->
        <service
            android:name=".ResumeCarAppService"
            android:exported="true"
            android:intentMatchingFlags="allowNullAction">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Legacy "Android Auto for apps" declaration — gearhead's own
             CAR.VALIDATOR checks for this independently of everything above
             ("Package DENIED; Uses for TEMPLATE not defined [com.ytmprobe]",
             confirmed live via logcat while opening AA's Customize Launcher).
             See res/xml/automotive_app_desc.xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Foreground service so session appear/disappear events keep being
             logged overnight and during the drive. dataSync, not
             mediaPlayback: this service polls and syncs session/favorites
             state, it never plays audio itself — declaring mediaPlayback
             here was a category error that (very plausibly) explains why
             this notification kept surfacing in Samsung's "Live
             notifications" lock-screen panel despite VISIBILITY_SECRET:
             OEM lock-screen exemptions for that type are meant for actual
             playback controls. -->
        <service
            android:name=".SessionLogger"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
